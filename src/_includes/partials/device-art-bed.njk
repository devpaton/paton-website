{%- set a = art[lang] -%}
{#
  The thing at the bed, drawn as the object rather than as a diagram: a pad with one large
  need button, a quieter second choice and a separate emergency, and the call already leaving.
  Deliberately shape-only — no readable text — so it reads at 200px to someone who has never
  been shown a screenshot.
#}
<svg
  class="card__art"
  viewBox="0 0 220 180"
  role="img"
  aria-label="{{ a.bedDeviceAria }}"
  focusable="false"
>
  <defs>
    <style>
      .db-shell { fill: #ffffff; stroke: #ddd2cf; }
      .db-screen { fill: #faf7f6; }
      .db-choice { fill: #ffffff; stroke: #f0e9e7; }
      .db-hardware { fill: #ddd2cf; }
    </style>
  </defs>

  <!-- the pad itself: rounded shell, camera dot, screen inset -->
  <rect class="db-shell" x="18" y="16" width="150" height="148" rx="22" stroke-width="2.5" />
  <circle class="db-hardware" cx="93" cy="28" r="3" />
  <rect class="db-screen" x="30" y="38" width="126" height="104" rx="12" />

  <!-- the need the patient picks -->
  <rect x="40" y="48" width="106" height="38" rx="12" fill="#e77e4e" />
  <rect x="54" y="63" width="52" height="8" rx="4" fill="#ffffff" />

  <!-- the short list it sits in -->
  <rect class="db-choice" x="40" y="94" width="106" height="22" rx="10" stroke-width="1.5" />
  <rect x="52" y="101" width="44" height="7" rx="3.5" fill="#ddd2cf" />

  <!-- the emergency, kept apart from the list -->
  <rect x="40" y="122" width="106" height="20" rx="10" fill="#7a0a1c" />
  <circle cx="54" cy="132" r="4" fill="#e77e4e" />
  <rect x="66" y="129" width="40" height="6" rx="3" fill="#e6c3bb" />

  <rect class="db-hardware" x="68" y="150" width="50" height="4" rx="2" />

  <!-- the call, on its way out of the room -->
  <path
    d="M174 70 C 192 62, 200 46, 202 34"
    fill="none"
    stroke="#e77e4e"
    stroke-width="2.5"
    stroke-dasharray="5 6"
    stroke-linecap="round"
  />
  <circle cx="202" cy="28" r="5" fill="#e77e4e" />
</svg>
