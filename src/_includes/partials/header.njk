<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__brand" href="/" aria-label="{{ site.name }} home">
      {% include "partials/logo.njk" %}
    </a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="site-header__toggle-bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {% for item in site.nav %}
          <li>
            <a
              href="{{ item.url }}"
              {% if page.url == item.url %}aria-current="page"{% endif %}
            >{{ item.text }}</a>
          </li>
        {% endfor %}
      </ul>
      <a class="button button--small" href="mailto:{{ site.email }}?subject=PATON%20—%20talk%20to%20us">
        Talk to us
      </a>
    </nav>
  </div>
</header>
