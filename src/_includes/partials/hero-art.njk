{%- set a = art[lang] -%}
{#
  Abstract product diagram: a bed device raises a specific need, the nurse device shows it
  already prioritised and already routed to the right qualification. Drawn, not photographed —
  the rebuild carries no stock photography on any page.
#}
<svg
  class="hero__art"
  viewBox="0 0 560 500"
  role="img"
  aria-label="{{ a.heroAria }}"
  focusable="false"
>
  <defs>
    <style>
      .ha-panel { fill: #ffffff; stroke: #ece5e3; }
      .ha-row { fill: #faf7f6; stroke: #f0e9e7; }
      .ha-title { font: 700 15px Manrope, system-ui, sans-serif; fill: #1c1315; }
      .ha-meta { font: 500 12.5px Manrope, system-ui, sans-serif; fill: #5f5052; }
      .ha-eyebrow { font: 700 11.5px Manrope, system-ui, sans-serif; fill: #8a7b7d; letter-spacing: 1.5px; }
      .ha-need { font: 700 19px Manrope, system-ui, sans-serif; fill: #ffffff; }
      /* CSS wins over a fill attribute in SVG, so the on-maroon variants need their own rules. */
      .ha-eyebrow--light { fill: #e6c3bb; }
      .ha-meta--light { fill: #dcbdb9; }
      .ha-tag { font: 700 11px Manrope, system-ui, sans-serif; }
    </style>
  </defs>

  <!-- nurse device -->
  <rect class="ha-panel" x="190" y="30" width="350" height="420" rx="28" stroke-width="1.5" />
  <text class="ha-eyebrow" x="214" y="76">{{ a.nurseDevice }}</text>
  <line x1="214" y1="94" x2="516" y2="94" stroke="#f0e9e7" stroke-width="1.5" />

  <g>
    <rect class="ha-row" x="210" y="116" width="310" height="84" rx="16" stroke-width="1.5" />
    <rect x="228" y="134" width="4" height="48" rx="2" fill="#b7142c" />
    <text class="ha-title" x="246" y="152">{{ a.emergency }}</text>
    <text class="ha-meta" x="246" y="174">{{ a.room }} 214 · {{ a.bed }} 2 · 0:12</text>
    <rect x="440" y="146" width="62" height="24" rx="12" fill="#fdeceb" />
    <text class="ha-tag" x="471" y="162" text-anchor="middle" fill="#b7142c">{{ a.tagNow }}</text>
  </g>

  <g>
    <rect class="ha-row" x="210" y="216" width="310" height="84" rx="16" stroke-width="1.5" />
    <rect x="228" y="234" width="4" height="48" rx="2" fill="#e77e4e" />
    <text class="ha-title" x="246" y="252">{{ a.painRelief }}</text>
    <text class="ha-meta" x="246" y="274">{{ a.room }} 209 · {{ a.bed }} 1 · 1:40</text>
    <rect x="440" y="246" width="62" height="24" rx="12" fill="#fdf3ee" />
    <text class="ha-tag" x="471" y="262" text-anchor="middle" fill="#d9622f">{{ a.tagNurse }}</text>
  </g>

  <g>
    <rect class="ha-row" x="210" y="316" width="310" height="84" rx="16" stroke-width="1.5" />
    <rect x="228" y="334" width="4" height="48" rx="2" fill="#7a0a1c" />
    <text class="ha-title" x="246" y="352">{{ a.bathroom }}</text>
    <text class="ha-meta" x="246" y="374">{{ a.room }} 211 · {{ a.bed }} 3 · 3:05</text>
    <rect x="440" y="346" width="62" height="24" rx="12" fill="#f7eded" />
    <text class="ha-tag" x="471" y="362" text-anchor="middle" fill="#7a0a1c">{{ a.tagAssist }}</text>
  </g>

  <text class="ha-meta" x="214" y="428">{{ a.heroFoot }}</text>

  <!-- the call travelling from the bed device to the ward -->
  <path
    d="M92 330 C 92 268, 150 258, 200 258"
    fill="none"
    stroke="#e77e4e"
    stroke-width="2"
    stroke-dasharray="6 7"
    stroke-linecap="round"
  />
  <circle cx="200" cy="258" r="5" fill="#e77e4e" />

  <!-- bed device -->
  <rect x="10" y="330" width="180" height="124" rx="24" fill="#7a0a1c" />
  <polygon points="172,358 166,348 154,348 148,358 154,368 166,368" fill="#e77e4e" />
  <text class="ha-eyebrow ha-eyebrow--light" x="32" y="363">{{ a.bedDevice }}</text>
  <text class="ha-need" x="32" y="398">{{ a.painRelief }}</text>
  <text class="ha-meta ha-meta--light" x="32" y="424">{{ a.room }} 209 · {{ a.bed }} 1</text>
</svg>
