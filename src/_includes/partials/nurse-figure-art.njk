{%- set a = art[lang] -%}
{#
  A nurse glancing at a request that has just landed. Flat geometric shapes in the same language
  as the step icons — a rounded head, no face — so it stays a diagram of the moment rather than
  a drawing of a particular person.
#}
<svg
  class="figure-art__svg"
  viewBox="0 0 220 180"
  role="img"
  aria-label="{{ a.nurseFigureAria }}"
  focusable="false"
>
  <defs>
    <style>
      .nf-body { fill: #7a0a1c; }
      .nf-shell { fill: #ffffff; stroke: #ddd2cf; }
      .nf-screen { fill: #faf7f6; }
      .nf-hardware { fill: #ddd2cf; }
      .nf-ping { fill: none; stroke: #e77e4e; stroke-linecap: round; }
    </style>
  </defs>

  <rect class="nf-body" x="48" y="72" width="24" height="22" />
  <path class="nf-body" d="M14 172 V128 C14 102 26 90 46 90 H74 C94 90 106 102 106 128 V172 Z" />
  <circle class="nf-body" cx="60" cy="58" r="22" />

  <!-- collar and badge: the only detail the figure gets -->
  <path
    d="M48 94 L60 110 L72 94"
    fill="none"
    stroke="#e6c3bb"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="88" cy="124" r="6" fill="#e77e4e" />

  <!-- the arm holding the phone up, drawn before the phone so the hand sits behind it -->
  <path
    d="M98 138 Q128 146 136 124"
    fill="none"
    stroke="#7a0a1c"
    stroke-width="15"
    stroke-linecap="round"
  />

  <rect class="nf-shell" x="128" y="52" width="52" height="76" rx="12" stroke-width="2.5" />
  <rect class="nf-screen" x="135" y="62" width="38" height="56" rx="8" />
  <rect x="140" y="68" width="28" height="16" rx="6" fill="#e77e4e" />
  <rect x="140" y="90" width="28" height="6" rx="3" fill="#ddd2cf" />
  <rect x="140" y="101" width="18" height="6" rx="3" fill="#f0e9e7" />
  <rect class="nf-hardware" x="142" y="121" width="24" height="3" rx="1.5" />

  <!-- the request arriving -->
  <path class="nf-ping" d="M186 56 A 13 13 0 0 1 186 76" stroke-width="3" />
  <path class="nf-ping" d="M192 50 A 21 21 0 0 1 192 82" stroke-width="2.25" />
  <path class="nf-ping" d="M198 44 A 29 29 0 0 1 198 88" stroke-width="1.5" />
</svg>
