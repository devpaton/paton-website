{#
  The thing staff carry: a phone with three requests already in order, and a ping arriving.
  Same shape-only treatment as device-art-bed.njk — the ordering is shown by the colour of the
  bar down the side of each row, not by text nobody could read at this size.
#}
<svg
  class="card__art"
  viewBox="0 0 220 180"
  role="img"
  aria-label="A phone carried on shift, showing three open requests in order with an emergency at the top, as a new one arrives."
  focusable="false"
>
  <defs>
    <style>
      .dn-shell { fill: #ffffff; stroke: #ddd2cf; }
      .dn-screen { fill: #faf7f6; }
      .dn-hardware { fill: #ddd2cf; }
      .dn-what { fill: #5f5052; }
      .dn-where { fill: #ddd2cf; }
      .dn-ping { fill: none; stroke: #e77e4e; stroke-linecap: round; }
    </style>
  </defs>

  <!-- the phone -->
  <rect class="dn-shell" x="42" y="8" width="104" height="164" rx="22" stroke-width="2.5" />
  <rect class="dn-hardware" x="82" y="18" width="24" height="4" rx="2" />
  <rect class="dn-screen" x="52" y="30" width="84" height="124" rx="12" />

  <!-- the emergency, always on top -->
  <rect x="58" y="38" width="72" height="32" rx="10" fill="#fdeceb" />
  <rect x="65" y="46" width="4" height="16" rx="2" fill="#b7142c" />
  <rect class="dn-what" x="76" y="48" width="44" height="6" rx="3" />
  <rect class="dn-where" x="76" y="58" width="28" height="5" rx="2.5" />

  <!-- the one that just came in -->
  <rect x="58" y="78" width="72" height="32" rx="10" fill="#fdf3ee" stroke="#f4dbca" stroke-width="1.5" />
  <rect x="65" y="86" width="4" height="16" rx="2" fill="#e77e4e" />
  <rect class="dn-what" x="76" y="88" width="44" height="6" rx="3" />
  <rect class="dn-where" x="76" y="98" width="28" height="5" rx="2.5" />

  <!-- the one that has been waiting longer -->
  <rect x="58" y="118" width="72" height="32" rx="10" fill="#ffffff" stroke="#f0e9e7" stroke-width="1.5" />
  <rect x="65" y="126" width="4" height="16" rx="2" fill="#7a0a1c" />
  <rect class="dn-what" x="76" y="128" width="36" height="6" rx="3" />
  <rect class="dn-where" x="76" y="138" width="28" height="5" rx="2.5" />

  <rect class="dn-hardware" x="78" y="160" width="32" height="4" rx="2" />

  <!-- the ping: the new request landing in someone's hand -->
  <path class="dn-ping" d="M158 50 A 13 13 0 0 1 158 70" stroke-width="3" />
  <path class="dn-ping" d="M164 44 A 21 21 0 0 1 164 76" stroke-width="2.25" />
  <path class="dn-ping" d="M170 38 A 29 29 0 0 1 170 82" stroke-width="1.5" />
</svg>
